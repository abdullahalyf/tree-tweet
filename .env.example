# Supabase Public Configuration (Accessible in browser and server)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only Service Role Key (NEVER expose to the browser or prefix with NEXT_PUBLIC_)
# Used for backend scripts, automated database seeding, or administrative actions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
